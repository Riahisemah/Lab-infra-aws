# ==================== SERVEUR ====================
PORT=3000
NODE_ENV=production

# ==================== BASE DE DONNÉES ====================
# MongoDB local (par défaut)
#MONGO_URL=mongodb://localhost:27017/ecommerce

# MongoDB avec Docker
MONGO_URL=mongodb://mongodb:27017/ecommerce


# ==================== SÉCURITÉ ====================
# Secret pour les sessions JWT
JWT_SECRET=shopcloud_super_secret_key_change_this_in_production_2025

# Secret pour les cookies
SESSION_SECRET=shopcloud_session_secret_change_this_too

# ==================== EMAIL (optionnel) ====================
# Pour l'envoi de confirmations de commande
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASS=votre_mot_de_passe
ADMIN_EMAIL=admin@shopcloud.com

# ==================== PAIEMENT (optionnel) ====================
# Stripe pour les paiements
STRIPE_PUBLIC_KEY=pk_test_votre_cle_publique
STRIPE_SECRET_KEY=sk_test_votre_cle_secrete

# PayPal
PAYPAL_CLIENT_ID=votre_client_id
PAYPAL_CLIENT_SECRET=votre_client_secret

# ==================== ADMIN ====================
# Compte administrateur par défaut (créé au premier démarrage)
ADMIN_EMAIL=admin@shopcloud.com
ADMIN_PASSWORD=Admin123456
ADMIN_NAME=Administrateur

# ==================== FONCTIONNALITÉS ====================
# Activer/désactiver certaines fonctionnalités
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_PAYMENT_GATEWAY=false

# Limites
MAX_CART_ITEMS=50
MAX_ORDER_ITEMS=100
FREE_SHIPPING_THRESHOLD=50

# ==================== CORS ====================
# Domaines autorisés (séparés par des virgules)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ==================== LOGGING ====================
LOG_LEVEL=info
LOG_TO_FILE=false